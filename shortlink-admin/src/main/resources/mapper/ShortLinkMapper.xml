<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shortlink.system.mapper.ShortLinkMapper">

    <!-- Result Map -->
    <resultMap id="ShortLinkResult" type="com.shortlink.system.entity.ShortLink">
        <id     property="id"           column="id"/>
        <result property="userId"       column="user_id"/>
        <result property="shortCode"    column="short_code"/>
        <result property="originalUrl"  column="original_url"/>
        <result property="title"        column="title"/>
        <result property="description"  column="description"/>
        <result property="expireTime"   column="expire_time"/>
        <result property="clickCount"   column="click_count"/>
        <result property="status"       column="status"/>
        <result property="delFlag"      column="del_flag"/>
        <result property="createTime"   column="create_time"/>
        <result property="updateTime"   column="update_time"/>
    </resultMap>

    <!-- Paginated query by user ID with optional filters -->
    <select id="selectPageByUserId" resultMap="ShortLinkResult">
        SELECT *
        FROM short_link
        WHERE user_id = #{userId}
        <if test="title != null and title != ''">
            AND title LIKE CONCAT('%', #{title}, '%')
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY create_time DESC
    </select>

    <!-- Daily click counts for chart data -->
    <select id="countByDay" resultType="java.util.HashMap">
        SELECT
            DATE(access_time) AS `date`,
            COUNT(*)          AS `count`
        FROM short_link_log
        WHERE link_id = #{linkId}
        AND access_time >= DATE_SUB(CURDATE(), INTERVAL #{days} DAY)
        GROUP BY DATE(access_time)
        ORDER BY `date` ASC
    </select>

</mapper>
