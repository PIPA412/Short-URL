# ============================================================
# Docker Compose 环境变量
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=zsc

# ---- Redis ----
REDIS_PASSWORD=

# ---- Java 后端 ----
JAVA_OPTS=-Xms256m -Xmx512m
SPRING_PROFILES_ACTIVE=druid,docker
TZ=Asia/Shanghai

# ---- 数据持久化路径 ----
UPLOAD_PATH=./docker/upload
LOG_PATH=./docker/logs
MYSQL_DATA_PATH=./docker/mysql/data
